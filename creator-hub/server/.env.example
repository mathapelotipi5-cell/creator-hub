PORT=5000
MONGO_URI=mongodb+srv://<user>:<password>@<cluster>.mongodb.net/creatorhub?retryWrites=true&w=majority
JWT_SECRET=replace_with_a_long_random_string
JWT_EXPIRES_IN=7d
# Comma-separated list of allowed frontend origins
CLIENT_ORIGIN=http://localhost:5173
# Used once by `npm run seed:creator` to create the initial creator account
CREATOR_EMAIL=creator@example.com
CREATOR_PASSWORD=replace_with_a_unique_password_at_least_12_chars
CREATOR_NAME=Your name
SITE_NAME=Your creator site
CREATOR_TAGLINE=Your tagline
CREATOR_INTRO=Your introduction
CREATOR_AVATAR_URL=
